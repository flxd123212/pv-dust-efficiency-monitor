# Local gateway. Copy values into environment variables or a private .env file.
PV_ROLE=gateway
PV_DEVICE_ID=PV01
PV_PORT=8787
PV_HOST=0.0.0.0
# PV_PASSWORD=use-a-private-password-at-least-12-characters
# PV_SERIAL_PORT=COM5
# Cloud broker credentials are optional for LAN-only use.
# PV_MQTT_URL=mqtts://your-broker.example.com:8883
# PV_MQTT_USERNAME=your-gateway-account
# PV_MQTT_PASSWORD=your-gateway-password
# OneNET replaces the optional private MQTT broker above. Never commit real keys.
# PV_CLOUD_PROVIDER=onenet
# PV_ONENET_PRODUCT_ID=your-product-id
# PV_ONENET_DEVICE_NAME=your-device-name
# PV_ONENET_DEVICE_KEY=your-base64-device-key
# PV_ONENET_REPORT_MS=5000
# The gateway creates a 24-hour MQTT password Token and renews it automatically.
# npm run token:onenet writes a manual-use Token to data/onenet-token.secret.
